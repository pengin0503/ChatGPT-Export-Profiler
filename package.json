{
  "name": "chatgpt-export-profiler",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "make:offline": "node scripts/make-offline-package.mjs",
    "serve:offline": "node scripts/serve-offline.mjs",
    "make:fixture:1k": "node scripts/generate-large-fixture.mjs --conversations 1000 --output tests/fixtures/generated-1k.zip",
    "make:fixture:10k": "node scripts/generate-large-fixture.mjs --conversations 10000 --output tests/fixtures/generated-10k.zip",
    "make:fixture:50k": "node scripts/generate-large-fixture.mjs --conversations 50000 --output tests/fixtures/generated-50k.zip"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "@zip.js/zip.js": "2.18.2",
    "idb": "8.0.3",
    "js-tiktoken": "1.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
